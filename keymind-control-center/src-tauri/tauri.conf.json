{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "KeyStroke",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.keystroke.app",
      "icon": [
        "icons/icon.ico"
      ],
      "resources": [
        "WebView2Loader.dll"
      ],
      "windows": {
        "webviewInstallMode": {
          "type": "embedBootstrapper"
        },
        "allowDowngrades": false,
        "nsis": {
          "installMode": "perMachine"
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "KeyStroke Control Center",
        "width": 1080,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "palette",
        "title": "",
        "url": "palette.html",
        "width": 560,
        "height": 120,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": false,
        "skipTaskbar": true,
        "focus": true
      }
    ]
  }
}
