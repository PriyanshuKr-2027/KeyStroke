{
  "name": "keymind-sync-server",
  "version": "0.1.0",
  "description": "Fastify + Prisma + PostgreSQL + Supabase Auth + Redis cloud sync API server for KeyMind.",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx tsc && npx prisma generate",
    "start": "node dist/index.js",
    "dev": "npx ts-node-dev --respawn src/index.ts",
    "prisma:migrate": "npx prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.14.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
